---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminApp from '../../components/admin/AdminApp';
import { loadIndex } from '../../lib/content';

const { research, posts, tags } = loadIndex();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const indexUrl = `${base}index.json`;
const topics = research.map((item) => ({ slug: item.slug, title: item.title }));
const styleExcerpts = posts.map((post) => post.excerpt).filter(Boolean).slice(0, 6);
const existingTags = Object.keys(tags).sort();
---
<AdminLayout title="Content editor">
  <div class="wrap page admin-page">
    <p class="kicker">Unlisted</p>
    <AdminApp client:load indexUrl={indexUrl} research={topics} styleExcerpts={styleExcerpts} existingTags={existingTags} />
  </div>
</AdminLayout>
