---
import Layout from '../layouts/Layout.astro';
import PublicationList from '../components/PublicationList';
import { formatAuthors, formatDate, paperPosts } from '../lib/content';

const papers = paperPosts().map((post) => ({
  slug: post.slug,
  title: post.paper?.title || post.title,
  date: formatDate(post.date),
  href: `${import.meta.env.BASE_URL}blog/${post.slug}/`,
  authors: post.paper?.authors?.length ? formatAuthors(post.paper.authors) : formatAuthors(post.authors),
  journal: post.paper?.journal || '',
  year: post.paper?.year || post.date.slice(0, 4),
  doi: post.paper?.doi || post.doi || '',
  excerpt: post.excerpt,
}));
---
<Layout title="Papers">
  <div class="wrap page">
    <h1 class="page-title">Papers</h1>
    <p class="lede">Posts tagged <code>#paper</code>, with bibliographic metadata resolved from the DOI where needed.</p>
    <PublicationList client:load papers={papers} />
  </div>
</Layout>
