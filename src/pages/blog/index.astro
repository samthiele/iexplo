---
import Layout from '../../layouts/Layout.astro';
import TagFilter from '../../components/TagFilter';
import { assetUrl, formatDate, loadIndex } from '../../lib/content';

const { posts, tags } = loadIndex();
const base = import.meta.env.BASE_URL;
const cards = posts.map((post) => ({
  slug: post.slug,
  title: post.title,
  date: formatDate(post.date),
  excerpt: post.excerpt,
  tags: post.tags,
  href: `${base}blog/${post.slug}/`,
  image: post.image ? assetUrl('posts', post.slug, post.image) : '',
}));
---
<Layout title="Blog">
  <div class="wrap page">
    <h1 class="page-title">Our blog</h1>
    <p class="lede">Paper alerts, field notes, and software updates from the group.</p>
    <TagFilter client:load posts={cards} allTags={Object.keys(tags).sort()} />
  </div>
</Layout>
