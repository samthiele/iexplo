---
import Layout from '../../layouts/Layout.astro';
import { assetUrl, formatAuthors, formatDate, loadIndex, renderMarkdown } from '../../lib/content';

export function getStaticPaths() {
  return loadIndex().posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const paper = post.paper;
---
<Layout title={post.title} description={post.excerpt || post.title}>
  <div class="wrap page">
    <p class="kicker">{formatDate(post.date)}</p>
    <h1 class="page-title">{post.title}</h1>
    <div class="chips">
      {post.tags.map((tag) => <a class="chip" href={`${base}blog/tag/${tag}/`}>#{tag}</a>)}
    </div>
    {post.image ? (
      <img class="hero-img" src={assetUrl('posts', post.slug, post.image)} alt="" />
    ) : null}
    {paper?.doi ? (
      <aside class="cite">
        <div class="kicker">Paper</div>
        <strong>{paper.title || post.title}</strong>
        {paper.authors?.length ? <div class="meta">{formatAuthors(paper.authors)}</div> : null}
        {paper.journal ? <div class="meta"><em>{paper.journal}</em>{paper.year ? ` (${paper.year})` : ''}</div> : null}
        <div class="meta"><a href={paper.url || `https://doi.org/${paper.doi}`}>{paper.doi}</a></div>
      </aside>
    ) : null}
    <article class="prose" set:html={renderMarkdown(post.body, 'posts', post.slug)} />
  </div>
</Layout>
