---
import Layout from '../../layouts/Layout.astro';
import { assetUrl, loadIndex, renderMarkdown } from '../../lib/content';

export function getStaticPaths() {
  return loadIndex().research.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const { projects } = loadIndex();
const linked = projects.filter((p) => (topic.projects || []).includes(p.slug) || (p.research || []).includes(topic.slug));
const base = import.meta.env.BASE_URL;
---
<Layout title={topic.title} description={topic.subtitle || topic.title}>
  <div class="wrap page">
    <p class="kicker">Research</p>
    <h1 class="page-title">{topic.title}</h1>
    {topic.subtitle ? <p class="lede">{topic.subtitle}</p> : null}
    {topic.image ? <img class="hero-img" src={assetUrl('research', topic.slug, topic.image)} alt="" /> : null}
    <article class="prose" set:html={renderMarkdown(topic.body, 'research', topic.slug)} />
    {linked.length ? (
      <section>
        <h2>Projects</h2>
        <div class="grid">
          {linked.map((project) => (
            <a class="card" href={`${base}projects/${project.slug}/`}>
              <div class="pic">
                {project.image ? <img src={assetUrl('projects', project.slug, project.image)} alt="" /> : <div class="ph" />}
              </div>
              <div class="pad">
                <p class="tag">{project.years || 'Project'}</p>
                <h3>{project.title}</h3>
                {project.funding ? <p class="meta">{project.funding}</p> : null}
              </div>
            </a>
          ))}
        </div>
      </section>
    ) : null}
  </div>
</Layout>
